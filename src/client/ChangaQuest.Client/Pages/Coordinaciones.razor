@page "/coordinaciones"
@using Microsoft.JSInterop
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Mis changas · Changa Quest</PageTitle>

<main class="page">
    <header class="brand">
        <p class="eyebrow">MIS CHANGAS</p>
        <h1>Coordinaciones</h1>
        <p class="intro">Consultá tus coordinaciones y las publicaciones que todavía no tienen asignación.</p>
    </header>

    @if (!string.IsNullOrWhiteSpace(Success))
    {
        <p class="status" role="status">@Success</p>
    }

    <section class="changa-list" aria-label="Changas asignadas">
        <h2>Changas asignadas</h2>
        @if (CoordinationLoading)
        {
            <p class="status" role="status">Cargando tus coordinaciones…</p>
        }
        else if (!string.IsNullOrWhiteSpace(CoordinationError))
        {
            <p class="field-error" role="alert">@CoordinationError</p>
            <button class="button secondary" type="button" @onclick="LoadCoordinationsAsync">Reintentar coordinaciones</button>
        }
        else if (Coordinations.Count == 0)
        {
            <p class="status" role="status">Todavía no tenés changas asignadas para coordinar.</p>
        }
        else
        {
            @foreach (var item in Coordinations)
            {
                <article class="changa-card" @key="item.ChangaId">
                    <h3>@item.Description</h3>
                    <p>Participás como @(item.Role == "worker" ? "persona realizadora" : "persona solicitante").</p>
                    @if (item.HasMutualConsent && !string.IsNullOrWhiteSpace(item.OtherPhone))
                    {
                        <p class="status" role="status">La otra parte aceptó compartir su teléfono ficticio: <strong>@item.OtherPhone</strong></p>
                    }
                    else
                    {
                        <p class="status" role="status">@(item.OtherPartyConsent == "accepted" ? "La otra parte aceptó; falta tu decisión para compartir los teléfonos." : "La otra parte no compartió su teléfono; los teléfonos siguen ocultos.")</p>
                    }
                    @if (item.CancellationRequest is { Status: "pending" } cancellation &&
                         cancellation.RequestedByRole != item.Role)
                    {
                        <p class="status" role="status">La otra parte propuso cancelar esta changa por acuerdo mutuo.</p>
                        <button class="button secondary" type="button" @onclick="() => RespondCancellationAsync(item.ChangaId, cancellation.Id, true)">Aceptar cancelación</button>
                        <button class="button secondary" type="button" @onclick="() => RespondCancellationAsync(item.ChangaId, cancellation.Id, false)">Rechazar cancelación</button>
                    }
                    else if (item.CancellationRequest is { Status: "pending" })
                    {
                        <p class="status" role="status">Tu solicitud de cancelación está pendiente de respuesta.</p>
                    }
                    else if (item.CancellationRequest is null || item.CancellationRequest.Status == "rejected")
                    {
                        <button class="button secondary" type="button" @onclick="() => ProposeCancellationAsync(item.ChangaId)">Proponer cancelación</button>
                    }
                    else if (item.CancellationRequest.Status == "accepted")
                    {
                        <p class="status" role="status">La cancelación fue confirmada y la asignación fue liberada.</p>
                    }
                    <a class="button-link" href="@($"/tareas/{item.ChangaId}/coordinacion")">Ver coordinación</a>
                    <a class="button-link" href="@($"/tareas/{item.ChangaId}/calificacion")">Consultar disponibilidad para calificar</a>
                    @if (!string.IsNullOrWhiteSpace(item.OtherPartyId))
                    {
                        <a class="button-link" href="@($"/perfil/{Uri.EscapeDataString(item.OtherPartyId)}")">Ver perfil de la otra parte</a>
                    }
                </article>
            }
        }
    </section>

    <section class="changa-list" aria-label="Publicadas por mí">
        <h2>Publicadas por mí</h2>
        @if (PublicationLoading)
        {
            <p class="status" role="status">Cargando tus publicaciones…</p>
        }
        else if (!string.IsNullOrWhiteSpace(PublicationError))
        {
            <p class="field-error" role="alert">@PublicationError</p>
            <button class="button secondary" type="button" @onclick="RefreshPublicationsAsync">Reintentar publicaciones</button>
        }
        else if (MyPublications.Count == 0)
        {
            <p class="status" role="status">No tenés publicaciones propias sin asignación.</p>
        }
        else
        {
            @foreach (var item in MyPublications)
            {
                var confirmationTitleId = $"cancel-title-{item.Id}";
                <article class="changa-card" @key="item.Id">
                    <h3>@item.Description</h3>
                    <p>Zona: @item.Zone</p>
                    <p>Recompensa: @item.Reward.ToString("N0") ARS</p>
                    <p class="status" role="status">Estado: <strong>@DisplayStatus(item.Status)</strong></p>
                    @if (item.Status == "available")
                    {
                        <button class="button secondary" type="button" aria-label="Cancelar publicación: @item.Description" disabled="@Cancelling" @onclick="() => BeginCancellation(item.Id)">Cancelar publicación</button>
                    }
                    @if (PendingCancellationId == item.Id)
                    {
                        <div class="confirmation" role="group" aria-labelledby="@confirmationTitleId">
                            <h4 id="@confirmationTitleId">¿Cancelar esta publicación?</h4>
                            <p role="status">La changa dejará de estar disponible. La publicación se conservará con estado cancelado y no se podrá tomar.</p>
                            <button class="button" type="button" aria-label="Confirmar cancelación" disabled="@Cancelling" @onclick="ConfirmCancellationAsync">@(Cancelling ? "Cancelando…" : "Sí, cancelar publicación")</button>
                            <button class="button secondary" type="button" aria-label="Volver sin cancelar" disabled="@Cancelling" @onclick="DismissCancellation">Volver sin cancelar</button>
                        </div>
                    }
                </article>
            }
        }
        @if (!string.IsNullOrWhiteSpace(CancellationError))
        {
            <p class="field-error" role="alert">@CancellationError</p>
            <button class="button secondary" type="button" @onclick="RefreshPublicationsAsync">Actualizar publicaciones</button>
        }
    </section>
</main>

@code {
    private readonly List<CoordinationView> Coordinations = [];
    private readonly List<PublicationView> MyPublications = [];
    private bool CoordinationLoading = true;
    private bool PublicationLoading = true;
    private string? CoordinationError;
    private string? PublicationError;
    private string? CancellationError;
    private string? Success;
    private Guid? PendingCancellationId;
    private bool Cancelling;

    protected override Task OnInitializedAsync() =>
        Task.WhenAll(LoadCoordinationsAsync(), LoadPublicationsAsync());

    private async Task LoadCoordinationsAsync()
    {
        CoordinationLoading = true;
        CoordinationError = null;
        try
        {
            using var response = await Http.GetAsync("/api/v1/coordinations");
            if (!response.IsSuccessStatusCode)
            {
                CoordinationError = "No se pudieron cargar tus changas asignadas. Iniciá sesión e intentá de nuevo.";
                return;
            }

            var items = await response.Content.ReadFromJsonAsync<List<CoordinationView>>();
            if (items is null)
            {
                CoordinationError = "No se pudo leer la respuesta de tus coordinaciones. Intentá de nuevo.";
                return;
            }

            Coordinations.Clear();
            Coordinations.AddRange(items);
        }
        catch (HttpRequestException)
        {
            CoordinationError = "No se pudo conectar con el servidor al cargar tus coordinaciones. Intentá de nuevo.";
        }
        catch (OperationCanceledException)
        {
            CoordinationError = "La solicitud de coordinaciones tardó demasiado. Intentá de nuevo.";
        }
        catch (JsonException)
        {
            CoordinationError = "No se pudo leer la respuesta de tus coordinaciones. Intentá de nuevo.";
        }
        finally
        {
            CoordinationLoading = false;
        }
    }

    private async Task ProposeCancellationAsync(Guid changaId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "¿Querés proponer cancelar esta changa por acuerdo mutuo?"))
        {
            return;
        }

        Success = null;
        CoordinationError = null;
        try
        {
            using var response = await Http.PostAsync($"/api/v1/changas/{changaId}/cancellation-requests", null);
            if (!response.IsSuccessStatusCode)
            {
                CoordinationError = "No se pudo proponer la cancelación. La changa sigue asignada.";
                return;
            }

            Success = "La solicitud de cancelación quedó pendiente de respuesta.";
            await LoadCoordinationsAsync();
        }
        catch (HttpRequestException)
        {
            CoordinationError = "No se pudo conectar con el servidor. La changa sigue asignada.";
        }
        catch (OperationCanceledException)
        {
            CoordinationError = "La solicitud tardó demasiado. La changa sigue asignada.";
        }
    }

    private async Task RespondCancellationAsync(Guid changaId, Guid requestId, bool accept)
    {
        var action = accept ? "aceptar" : "rechazar";
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Querés {action} la solicitud de cancelación?"))
        {
            return;
        }

        Success = null;
        CoordinationError = null;
        try
        {
            using var response = await Http.PostAsJsonAsync(
                $"/api/v1/changas/{changaId}/cancellation-requests/{requestId}",
                new { accept });
            if (!response.IsSuccessStatusCode)
            {
                CoordinationError = "No se pudo registrar la respuesta. La changa mantiene su estado.";
                return;
            }

            Success = accept
                ? "La cancelación fue confirmada y la asignación fue liberada."
                : "La solicitud fue rechazada. La changa sigue asignada.";
            await LoadCoordinationsAsync();
        }
        catch (HttpRequestException)
        {
            CoordinationError = "No se pudo conectar con el servidor. La changa mantiene su estado.";
        }
        catch (OperationCanceledException)
        {
            CoordinationError = "La solicitud tardó demasiado. La changa mantiene su estado.";
        }
    }

    private async Task LoadPublicationsAsync(bool clearCancellationErrorOnSuccess = false)
    {
        PublicationLoading = true;
        PublicationError = null;
        try
        {
            using var response = await Http.GetAsync("/api/v1/changas/mine");
            if (!response.IsSuccessStatusCode)
            {
                PublicationError = "No se pudieron cargar tus publicaciones. Iniciá sesión e intentá de nuevo.";
                return;
            }

            var publications = await response.Content.ReadFromJsonAsync<List<PublicationView>>();
            if (publications is null)
            {
                PublicationError = "No se pudo leer la respuesta de tus publicaciones. Intentá de nuevo.";
                return;
            }

            MyPublications.Clear();
            MyPublications.AddRange(publications);
            if (clearCancellationErrorOnSuccess)
            {
                CancellationError = null;
            }

            if (PendingCancellationId is { } pendingId &&
                !MyPublications.Any(item => item.Id == pendingId && item.Status == "available"))
            {
                PendingCancellationId = null;
            }
        }
        catch (HttpRequestException)
        {
            PublicationError = "No se pudo conectar con el servidor al cargar tus publicaciones. Intentá de nuevo.";
        }
        catch (OperationCanceledException)
        {
            PublicationError = "La solicitud de publicaciones tardó demasiado. Intentá de nuevo.";
        }
        catch (JsonException)
        {
            PublicationError = "No se pudo leer la respuesta de tus publicaciones. Intentá de nuevo.";
        }
        finally
        {
            PublicationLoading = false;
        }
    }

    private Task RefreshPublicationsAsync() => LoadPublicationsAsync(clearCancellationErrorOnSuccess: true);

    private void BeginCancellation(Guid id)
    {
        if (Cancelling)
        {
            return;
        }

        PendingCancellationId = id;
        CancellationError = null;
    }

    private void DismissCancellation()
    {
        PendingCancellationId = null;
    }

    private async Task ConfirmCancellationAsync()
    {
        if (PendingCancellationId is not { } id || Cancelling)
        {
            return;
        }

        Cancelling = true;
        CancellationError = null;
        try
        {
            using var response = await Http.PostAsync($"/api/v1/changas/{id}/cancel", null);
            if (!response.IsSuccessStatusCode)
            {
                CancellationError = "No se pudo cancelar la publicación. Revisá su estado e intentá de nuevo.";
                await RefreshPublicationsAfterFailureAsync();
                return;
            }

            var updated = await response.Content.ReadFromJsonAsync<PublicationView>();
            if (updated is null || updated.Id != id || updated.Status != "cancelled")
            {
                CancellationError = "No se pudo confirmar la cancelación. Actualizá tus publicaciones antes de volver a intentar.";
                await RefreshPublicationsAfterFailureAsync();
                return;
            }

            var index = MyPublications.FindIndex(item => item.Id == id);
            if (index >= 0)
            {
                MyPublications[index] = updated;
            }
            PendingCancellationId = null;
        }
        catch (HttpRequestException)
        {
            CancellationError = "No se pudo conectar con el servidor. Revisá el estado e intentá de nuevo.";
            await RefreshPublicationsAfterFailureAsync();
        }
        catch (OperationCanceledException)
        {
            CancellationError = "La solicitud tardó demasiado. Revisá el estado e intentá de nuevo.";
            await RefreshPublicationsAfterFailureAsync();
        }
        catch (JsonException)
        {
            CancellationError = "No se pudo leer la respuesta. Actualizá tus publicaciones antes de volver a intentar.";
            await RefreshPublicationsAfterFailureAsync();
        }
        finally
        {
            Cancelling = false;
        }
    }

    private async Task RefreshPublicationsAfterFailureAsync()
    {
        await LoadPublicationsAsync();
        if (!string.IsNullOrWhiteSpace(PublicationError))
        {
            AppendPublicationRefreshError();
        }
    }

    private void AppendPublicationRefreshError()
    {
        CancellationError = $"{CancellationError} No se pudo actualizar el estado. Usá «Actualizar publicaciones» para comprobarlo.";
    }

    private static string DisplayStatus(string status) => status switch
    {
        "available" => "Disponible",
        "cancelled" => "Cancelada",
        "pending_review" => "Pendiente de revisión",
        "rejected" => "No aprobada",
        "assigned" => "Asignada",
        "pending_response" => "Pendiente de respuesta",
        "confirmed" => "Confirmada",
        "completion_review" => "Pendiente de revisión",
        _ => status
    };

    private sealed record CoordinationView(
        Guid ChangaId,
        string Description,
        string Role,
        string? OtherPartyId,
        string YourConsent,
        string OtherPartyConsent,
        bool HasMutualConsent,
        string? OtherPhone,
        CancellationView? CancellationRequest);

    private sealed record CancellationView(Guid Id, Guid ChangaId, string Status, string RequestedByRole);

    private sealed record PublicationView(
        Guid Id,
        string Description,
        string CategoryId,
        int Reward,
        string Zone,
        bool MaterialsNeeded,
        string? MaterialsProvider,
        string Status,
        string? ReviewReason,
        string AssignmentMode,
        bool IsSample,
        DateTimeOffset CreatedAt,
        double DistanceKm);
}
