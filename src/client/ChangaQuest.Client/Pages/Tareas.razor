@page "/tareas"
@inject HttpClient Http

<PageTitle>Ver tareas · Changa Quest</PageTitle>

<main class="page">
    <header class="brand">
        <p class="eyebrow">TABLÓN LOCAL</p>
        <h1>Ver tareas</h1>
        <p class="intro">Consultá changas disponibles y sus datos principales antes de comprometerte. La dirección exacta se mantiene privada.</p>
            <a class="button-link" href="/coordinaciones">Ver mis changas asignadas</a>
</header>

    <section class="account-card search-panel" aria-labelledby="search-heading">
        <h2 id="search-heading">Buscar por cercanía</h2>
        <div class="field">
            <label for="radius">Radio de búsqueda</label>
            <select id="radius" @bind="RadiusKm" @bind:after="LoadAsync">
                @foreach (var radius in SupportedRadii)
                {
                    <option value="@radius">@radius km</option>
                }
            </select>
        </div>
        <div class="search-grid">
            <div class="field">
                <label for="latitude">Latitud de referencia</label>
                <input id="latitude" type="number" step="0.0001" @bind="Latitude" />
            </div>
            <div class="field">
                <label for="longitude">Longitud de referencia</label>
                <input id="longitude" type="number" step="0.0001" @bind="Longitude" />
            </div>
        </div>
        <label class="checkbox-field" for="save-preference">
            <input id="save-preference" type="checkbox" @bind="SavePreference" />
            <span>Guardar esta ubicación como preferencia</span>
        </label>
        <button class="button secondary" type="button" @onclick="LoadAsync">Actualizar búsqueda</button>
    </section>

    @if (Loading)
    {
        <p class="status" role="status">Cargando changas…</p>
    }
    else if (!string.IsNullOrWhiteSpace(Error))
    {
        <p class="field-error" role="alert">@Error</p>
        <button class="button secondary" type="button" @onclick="LoadAsync">Reintentar</button>
    }
    else if (!SignedIn)
    {
        <p class="status" role="status">Iniciá sesión con una cuenta adulta y correo verificado para ver las tareas.</p>
        <a class="button-link" href="/">Ir a iniciar sesión</a>
    }
    else if (Changas.Count == 0)
    {
        <p class="status" role="status">Todavía no hay changas disponibles.</p>
    }
    else
    {
        <section class="changa-list" aria-label="Changas disponibles">
            @foreach (var changa in Changas)
            {
                <article class="changa-card" @key="changa.Id">
                    @if (changa.IsSample)
                    {
                        <p class="sample-label">Ejemplo ficticio</p>
                    }
                    <h2><a href="@($"/tareas/{changa.Id}")">@changa.Description</a></h2>
                    <dl class="changa-details">
                        <div><dt>Recompensa</dt><dd>@changa.Reward.ToString("N0") ARS</dd></div>
                        <div><dt>Zona aproximada</dt><dd>@changa.Zone</dd></div>
                        <div><dt>Distancia aproximada</dt><dd>@changa.DistanceKm.ToString("0.0") km</dd></div>
                        <div>
                            <dt>Materiales</dt>
                            <dd>@(changa.MaterialsNeeded ? MaterialsText(changa.MaterialsProvider) : "No hacen falta materiales")</dd>
                        </div>
                        <div><dt>Modalidad</dt><dd>Por orden de llegada</dd></div>
                    </dl>
                    <p class="status-label">Disponible</p>
                </article>
            }
        </section>
    }
</main>

@code {
    private readonly List<ChangaView> Changas = [];
    private bool Loading = true;
    private bool SignedIn;
    private string? Error;
    private const double DefaultLatitude = -31.4167;
    private const double DefaultLongitude = -64.1833;
    private static readonly int[] SupportedRadii = [1, 3, 5, 10];
    private int RadiusKm { get; set; } = 3;
    private double Latitude { get; set; } = DefaultLatitude;
    private double Longitude { get; set; } = DefaultLongitude;
    private bool SavePreference;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        Loading = true;
        Error = null;
        try
        {
            using var account = await Http.GetAsync("/api/v1/accounts/me");
            if (!account.IsSuccessStatusCode)
            {
                SignedIn = false;
                Changas.Clear();
                return;
            }

            SignedIn = true;
            var query = $"/api/v1/changas?latitude={Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture)}" +
                        $"&longitude={Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture)}" +
                        $"&radiusKm={RadiusKm}&savePreference={SavePreference.ToString().ToLowerInvariant()}";
            using var response = await Http.GetAsync(query);
            if (!response.IsSuccessStatusCode)
            {
                Error = "No se pudieron cargar las changas. Intentá de nuevo.";
                return;
            }

            var items = await response.Content.ReadFromJsonAsync<List<ChangaView>>();
            Changas.Clear();
            Changas.AddRange(items ?? []);
        }
        catch (HttpRequestException)
        {
            Error = "No se pudo conectar con el tablón. Intentá de nuevo.";
        }
        catch (JsonException)
        {
            Error = "No se pudo leer la respuesta del tablón. Intentá de nuevo.";
        }
        catch (OperationCanceledException)
        {
            Error = "La consulta tardó demasiado. Intentá de nuevo.";
        }
        finally
        {
            Loading = false;
        }
    }

    private static string MaterialsText(string? provider) => provider switch
    {
        "requester" => "Hacen falta; los aporta quien publica",
        "worker" => "Hacen falta; los aporta quien realiza",
        _ => "Hacen falta materiales"
    };

    private sealed record ChangaView(
        Guid Id,
        string Description,
        int Reward,
        string Zone,
        bool MaterialsNeeded,
        string? MaterialsProvider,
        string Status,
        string AssignmentMode,
        bool IsSample,
        DateTimeOffset CreatedAt,
        double DistanceKm);
}
