@page "/perfil"
@page "/perfil/{AccountId}"
@using System.Globalization
@inject HttpClient Http

<PageTitle>Perfil · Changa Quest</PageTitle>

<main class="page">
    <header class="brand">
        <p class="eyebrow">PERFIL</p>
        <h1>Experiencia en changas</h1>
        <p class="intro">Las calificaciones se muestran como un resumen; no se identifica quién envió cada nota.</p>
    </header>

    @if (Loading)
    {
        <p class="status" role="status">Cargando calificaciones…</p>
    }
    else if (!string.IsNullOrWhiteSpace(Error))
    {
        <p class="field-error" role="alert">@Error</p>
        <button class="button secondary" type="button" @onclick="LoadAsync">Reintentar</button>
    }
    else if (Profile is { RatingCount: > 0, AverageRating: not null })
    {
        <section class="account-card" aria-labelledby="rating-profile-heading">
            <h2 id="rating-profile-heading">Calificaciones recibidas</h2>
            <p>Promedio: <strong>@Profile.AverageRating.Value.ToString("0.0", CultureInfo.GetCultureInfo("es-AR"))</strong> / 5</p>
            <p>Cantidad: <strong>@Profile.RatingCount</strong></p>
        </section>
    }
    else
    {
        <p class="status" role="status">Todavía no hay calificaciones.</p>
    }

    @if (!string.IsNullOrWhiteSpace(AccountId))
    {
        <section class="account-card" aria-labelledby="block-account-heading">
            <h2 id="block-account-heading">No quiero futuras interacciones</h2>
            <p>Podés registrar un bloqueo para esta cuenta.</p>
            @if (ConfirmingBlock)
            {
                <div role="dialog" aria-modal="true" aria-labelledby="block-confirmation-heading">
                    <h3 id="block-confirmation-heading">¿Bloquear esta cuenta?</h3>
                    <p>El bloqueo no cancela ni resuelve una changa ya asignada.</p>
                    <button class="button" type="button" @onclick="ConfirmBlockAsync">Confirmar bloqueo</button>
                    <button class="button secondary" type="button" @onclick="CancelBlock">Cancelar</button>
                </div>
            }
            else
            {
                <button class="button secondary" type="button" @onclick="BeginBlock">Bloquear cuenta</button>
            }
            @if (!string.IsNullOrWhiteSpace(BlockMessage))
            {
                <p class="status" role="status">@BlockMessage</p>
            }
            @if (!string.IsNullOrWhiteSpace(BlockError))
            {
                <p class="field-error" role="alert">@BlockError</p>
            }
        </section>
    }
</main>

@code {
    [Parameter] public string? AccountId { get; set; }

    private RatingProfile? Profile;
    private bool Loading = true;
    private string? Error;
    private bool ConfirmingBlock;
    private string? BlockMessage;
    private string? BlockError;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        Loading = true;
        Error = null;
        var path = string.IsNullOrWhiteSpace(AccountId)
            ? "/api/v1/accounts/me/profile"
            : $"/api/v1/accounts/{Uri.EscapeDataString(AccountId)}/profile";
        try
        {
            using var response = await Http.GetAsync(path);
            if (!response.IsSuccessStatusCode)
            {
                Error = await ReadErrorAsync(response, "No se pudo cargar el perfil. Intentá de nuevo.");
                return;
            }

            Profile = await response.Content.ReadFromJsonAsync<RatingProfile>();
            if (Profile is null)
            {
                Error = "No se pudo leer el perfil. Intentá de nuevo.";
            }
        }
        catch (HttpRequestException)
        {
            Error = "No se pudo conectar con el servidor. Intentá de nuevo.";
        }
        catch (OperationCanceledException)
        {
            Error = "La solicitud tardó demasiado. Intentá de nuevo.";
        }
        catch (JsonException)
        {
            Error = "No se pudo leer la respuesta. Intentá de nuevo.";
        }
        finally
        {
            Loading = false;
        }
    }

    private void BeginBlock()
    {
        ConfirmingBlock = true;
        BlockMessage = null;
        BlockError = null;
    }

    private void CancelBlock() => ConfirmingBlock = false;

    private async Task ConfirmBlockAsync()
    {
        if (string.IsNullOrWhiteSpace(AccountId))
            return;

        try
        {
            using var response = await Http.PostAsync(
                $"/api/v1/accounts/{Uri.EscapeDataString(AccountId)}/block", null);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<AccountBlockResponse>();
                BlockMessage = result?.Status == "account_already_blocked"
                    ? "Esta cuenta ya estaba bloqueada."
                    : "Cuenta bloqueada. Esto no cancela ni resuelve una changa ya asignada.";
                ConfirmingBlock = false;
                return;
            }

            BlockError = await ReadErrorAsync(response, "No se pudo registrar el bloqueo. Intentá de nuevo.");
        }
        catch (HttpRequestException)
        {
            BlockError = "No se pudo conectar con el servidor. Intentá de nuevo.";
        }
        catch (OperationCanceledException)
        {
            BlockError = "La solicitud tardó demasiado. Intentá de nuevo.";
        }
        catch (JsonException)
        {
            BlockError = "No se pudo leer la respuesta. Intentá de nuevo.";
        }
    }

    private static async Task<string> ReadErrorAsync(HttpResponseMessage response, string fallback)
    {
        try
        {
            using var body = await JsonDocument.ParseAsync(await response.Content.ReadAsStreamAsync());
            if (body.RootElement.TryGetProperty("detail", out var detail) &&
                !string.IsNullOrWhiteSpace(detail.GetString()))
            {
                return detail.GetString()!;
            }
        }
        catch (JsonException)
        {
            return fallback;
        }

        return fallback;
    }

    private sealed record RatingProfile(double? AverageRating, int RatingCount);
    private sealed record AccountBlockResponse(string Status, string Detail);
}
